// Cloudflare Worker that serves the site: the single source of truth for
// hosting. Workers Builds runs `npm run build` and deploys dist/ on push.
// Response headers (security, caching) live in public/_headers.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beta-cristianserrano-ar",
  "compatibility_date": "2026-07-11",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
