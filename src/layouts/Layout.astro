---
interface Props {
  title: string;
  description: string;
  readingTime?: boolean;
}

const { title, description, readingTime = false } = Astro.props;
const pathname = Astro.url.pathname;

const isHome    = pathname === '/';
const isCV      = pathname.startsWith('/cv');
const isWork    = pathname.startsWith('/work');
const isContact = pathname.startsWith('/contact');

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Cristian Serrano",
  "jobTitle": "Head of Design",
  "worksFor": {
    "@type": "Organization",
    "name": "JustRelate",
    "url": "https://www.justrelate.com"
  },
  "url": "https://www.cristianserrano.ar",
  "sameAs": ["https://www.linkedin.com/in/cristianserrano"],
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Munich",
    "addressCountry": "DE"
  },
  "knowsAbout": [
    "Product Design", "Design Systems", "Design Operations",
    "Design Leadership", "UX Design", "AI Product Design", "SaaS"
  ],
  "description": "Cristian Serrano is a Senior Product Designer and Design Systems specialist with 17+ years of experience, based in Munich, Germany. Currently Head of Design at JustRelate."
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-02JHYJG539" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-02JHYJG539');
    </script>
    <!-- etracker -->
    <script id="_etLoader" type="text/javascript" charset="UTF-8" data-block-cookies="true" data-secure-code="L9bc0V" src="//code.etracker.com/code/e.js" async is:inline></script>

    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
    <meta name="description" content={description}>

    <!-- Open Graph / social sharing -->
    <meta property="og:type" content="website">
    <meta property="og:url" content={`https://www.cristianserrano.ar${pathname}`}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content="https://www.cristianserrano.ar/og-image.png">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content="https://www.cristianserrano.ar/og-image.png">

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <link rel="stylesheet" href="/css/main.css">
    <link rel="icon" type="image/png" href="/favicon.png" sizes="16x16 32x32">
    <script is:inline src="/js/header-behaviour.js"></script>
    <script is:inline src="/js/seniority.js"></script>
    {readingTime && <script is:inline src="/js/reading-time-estimation.js"></script>}
    <script is:inline src="/js/current-year.js"></script>
  </head>

  <body>
    <div class="page-wrapper">

      <header class="nav-visible">
        <nav id="top-navbar-container">
          <ul id="top-navbar">
            <li class={isHome    ? 'nav-selected' : ''}><a href="/">Home</a></li>
            <li class={isCV      ? 'nav-selected' : ''}><a href="/cv">CV</a></li>
            <li class={isWork    ? 'nav-selected' : ''}><a href="/work">Work</a></li>
            <li class={isContact ? 'nav-selected' : ''}><a href="/contact">Contact</a></li>
          </ul>
        </nav>
      </header>

      <div class="main-wrapper" id={readingTime ? 'content' : undefined}>
        <slot />

        <footer>
          <div class="footer-wrapper">
            <p class="footer-paragraph">Handcrafted with <span class="love">♥</span> en La Plata <span class="emoji" role="img" aria-label="argentina">🇦🇷</span> und München <span class="emoji" role="img" aria-label="deutschland">🇩🇪</span>.</p>
            <p class="footer-paragraph">&copy;<span class="current-year"></span> Cristian Serrano</p>
          </div>
        </footer>
      </div>

    </div>
  </body>
</html>
