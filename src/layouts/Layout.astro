---
interface Props {
  title: string;
  description: string;
  readingTime?: boolean;
}

const { title, description, readingTime = false } = Astro.props;
const pathname = Astro.url.pathname;

// accent modes offered to visitors; must match [accent="..."] in tokens.css
const accents = ['blue', 'purple', 'magenta', 'red', 'orange', 'green', 'emerald', 'sky'];

const isHome    = pathname === '/';
const isCV      = pathname.startsWith('/cv');
const isWork    = pathname.startsWith('/work');
const isContact = pathname.startsWith('/contact');

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Cristian Serrano",
  "jobTitle": "Head of Design",
  "worksFor": {
    "@type": "Organization",
    "name": "JustRelate",
    "url": "https://www.justrelate.com"
  },
  "url": "https://www.cristianserrano.ar",
  "sameAs": ["https://www.linkedin.com/in/cristianserrano"],
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Munich",
    "addressCountry": "DE"
  },
  "knowsAbout": [
    "Product Design", "Design Systems", "Design Operations",
    "Design Leadership", "UX Design", "AI Product Design", "SaaS"
  ],
  "description": "Cristian Serrano is a Senior Product Designer and Design Systems specialist with 17+ years of experience, based in Munich, Germany. Currently Head of Design at JustRelate."
};
---

<!DOCTYPE html>
<html lang="en" temperature="subtle" accent="blue">
  <head>
    <!-- Preconnect hints -->
    <link rel="preconnect" href="https://www.googletagmanager.com">
    <link rel="preconnect" href="https://www.google-analytics.com">
    <link rel="preconnect" href="https://code.etracker.com">

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-02JHYJG539" is:inline></script>
    <script defer is:inline src="/js/analytics.js"></script>
    <!-- etracker -->
    <script id="_etLoader" type="text/javascript" charset="UTF-8" data-block-cookies="true" data-secure-code="L9bc0V" src="//code.etracker.com/code/e.js" async is:inline></script>

    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
    <meta name="description" content={description}>
    <link rel="canonical" href={`https://www.cristianserrano.ar${pathname}`}>

    <!-- Open Graph / social sharing -->
    <meta property="og:type" content="website">
    <meta property="og:url" content={`https://www.cristianserrano.ar${pathname}`}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content="https://www.cristianserrano.ar/og-image.png">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content="https://www.cristianserrano.ar/og-image.png">

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Resolve the stored appearance before first paint, so there is no flash.
         "system" stores nothing and sets no attribute: :root carries
         color-scheme: light dark, so the OS is followed natively and live. -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        try {
          var s = localStorage.getItem('scheme');
          if (s === 'light' || s === 'dark') d.setAttribute('scheme', s);
          var a = localStorage.getItem('accent');
          if (a) d.setAttribute('accent', a);
        } catch (e) {}
      })();
    </script>

    <link rel="stylesheet" href="/css/tokens.css">
    <link rel="stylesheet" href="/css/main.css">
    <link rel="icon" type="image/png" href="/favicon.png" sizes="16x16 32x32">
    <script defer is:inline src="/js/header-behaviour.js"></script>
    <script defer is:inline src="/js/seniority.js"></script>
    {readingTime && <script defer is:inline src="/js/reading-time-estimation.js"></script>}
    <script defer is:inline src="/js/current-year.js"></script>
    <script defer is:inline src="/js/appearance.js"></script>
  </head>

  <body>
    <div class="page-wrapper">

      <header class="nav-visible">
        <nav id="top-navbar-container">
          <ul id="top-navbar">
            <li class={isHome    ? 'nav-selected' : ''}><a href="/">Home</a></li>
            <li class={isCV      ? 'nav-selected' : ''}><a href="/cv">CV</a></li>
            <li class={isWork    ? 'nav-selected' : ''}><a href="/work">Work</a></li>
            <li class={isContact ? 'nav-selected' : ''}><a href="/contact">Contact</a></li>
          </ul>

          <div class="appearance" role="group" aria-label="Appearance">
            <button type="button" class="scheme-toggle" data-scheme-toggle aria-live="polite">
              <span data-scheme-label>System</span>
            </button>
            <div class="accents" role="group" aria-label="Accent colour">
              {accents.map((name) => (
                <button
                  type="button"
                  class="accent-swatch"
                  data-accent={name}
                  style={`--swatch: var(--accent-500)`}
                  accent={name}
                  aria-label={name}
                  title={name}
                />
              ))}
            </div>
          </div>
        </nav>
      </header>

      <div class="main-wrapper" id={readingTime ? 'content' : undefined}>
        <slot />

        <footer>
          <div class="footer-wrapper">
            <p class="footer-paragraph">Handcrafted with <span class="love">♥</span> en La Plata <span class="emoji" role="img" aria-label="argentina">🇦🇷</span> und München <span class="emoji" role="img" aria-label="deutschland">🇩🇪</span>.</p>
            <p class="footer-paragraph">&copy;<span class="current-year"></span> Cristian Serrano</p>
          </div>
        </footer>
      </div>

    </div>
  </body>
</html>

<style>
  /* Matches #top-navbar li / a exactly: Inter 500, 2px accent underline.
     No borders, pills or rings -- the site has none. */
  nav#top-navbar-container { position: relative; }

  .appearance {
    position: absolute;
    top: 50%;
    right: max(2rem, calc(50% - 368px + 2rem));
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .scheme-toggle {
    font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", "Roboto",
                 "Oxygen", "Ubuntu", "Fira Sans", "Droid Sans", "Helvetica Neue",
                 Arial, sans-serif;
    font-size: 1rem;
    line-height: 1.4;
    letter-spacing: -0.011rem;
    font-weight: 500;
    color: var(--text-primary);
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-color: var(--link);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.1em;
  }
  .scheme-toggle:hover { color: var(--link); }

  .accents { display: flex; gap: 0.4rem; }

  .accent-swatch {
    width: 0.7rem;
    height: 0.7rem;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: var(--swatch);
    cursor: pointer;
    opacity: 0.35;
    transition: opacity 0.2s;
  }
  .accent-swatch:hover { opacity: 0.7; }
  .accent-swatch[aria-pressed="true"] { opacity: 1; }

  .scheme-toggle:focus-visible,
  .accent-swatch:focus-visible {
    outline: 2px solid var(--link);
    outline-offset: 3px;
  }

  @media (max-width: 46rem) {
    .appearance { gap: 0.7rem; }
    .scheme-toggle { font-size: 0.875rem; }
    .accent-swatch { width: 0.6rem; height: 0.6rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .accent-swatch { transition: none; }
  }
</style>
