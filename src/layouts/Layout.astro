---
import '../styles/index.css';
import PieceHeader from '../components/PieceHeader.astro';
import NextPiece from '../components/NextPiece.astro';
import { piece as getPiece, nextPiece, featured, href } from '../data/pieces';

interface Props {
  title: string;
  description: string;
  readingTime?: boolean;
  noindex?: boolean;
  /* On a case study: its slug in src/data/pieces.ts. The layout then draws
     the piece's first screen and the "next piece" at the end of the story. */
  piece?: string;
}

const { title, description, readingTime = false, noindex = false, piece } = Astro.props;
const pathname = Astro.url.pathname;
const current = piece ? getPiece(piece) : undefined;
const next = piece ? nextPiece(piece) : undefined;

// accent modes offered to visitors; must match [accent="..."] in styles/tokens/color.css
const accents = ['blue', 'purple', 'magenta', 'red', 'orange', 'green', 'emerald', 'sky'];

const nav = [
  { href: '/work/', label: 'Work', current: pathname.startsWith('/work') },
  { href: '/cv/',   label: 'CV',   current: pathname.startsWith('/cv') },
  { href: '/contact/', label: 'Contact', current: pathname.startsWith('/contact') },
];

/* What the guide needs to know about the room the visitor is in, and the
   featured pieces for its tours. Data, not code: a JSON block the CSP allows. */
const room = current
  ? { kind: 'piece', slug: current.slug, title: current.title, client: current.client, years: current.years,
      label: current.label, facts: current.facts,
      next: next && { title: next.title, href: href(next) } }
  : pathname.startsWith('/work') ? { kind: 'wall' }
  : pathname.startsWith('/cv') ? { kind: 'cv' }
  : pathname.startsWith('/contact') ? { kind: 'contact' }
  : pathname === '/' ? { kind: 'home' }
  : { kind: 'other' };
const guide = {
  room,
  pieces: featured.map((p) => ({ slug: p.slug, title: p.title, client: p.client, years: p.years, label: p.label, role: p.facts.role, category: p.facts.category, href: href(p) })),
};

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Cristian Serrano",
  "jobTitle": "Head of Design",
  "worksFor": {
    "@type": "Organization",
    "name": "JustRelate",
    "url": "https://www.justrelate.com"
  },
  "url": "https://www.cristianserrano.ar",
  "sameAs": ["https://www.linkedin.com/in/cristianserrano"],
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Munich",
    "addressCountry": "DE"
  },
  "knowsAbout": [
    "Product Design", "Design Systems", "Design Operations",
    "Design Leadership", "UX Design", "AI Product Design", "SaaS"
  ],
  "description": "Cristian Serrano is a Senior Product Designer and Design Systems specialist with 17+ years of experience, based in Munich, Germany. Currently Head of Design at JustRelate."
};
---

<!DOCTYPE html>
<html lang="en" temperature="cold" accent="blue">
  <head>
    <!-- Preconnect hints -->
    <link rel="preconnect" href="https://www.googletagmanager.com">
    <link rel="preconnect" href="https://www.google-analytics.com">
    <link rel="preconnect" href="https://code.etracker.com">

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-02JHYJG539" is:inline></script>
    <script defer is:inline src="/js/analytics.js"></script>
    <!-- etracker -->
    <script id="_etLoader" type="text/javascript" charset="UTF-8" data-block-cookies="true" data-secure-code="L9bc0V" src="https://code.etracker.com/code/e.js" async is:inline></script>

    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
    <meta name="description" content={description}>
    {noindex && <meta name="robots" content="noindex">}
    <link rel="canonical" href={`https://www.cristianserrano.ar${pathname}`}>

    <!-- Open Graph / social sharing -->
    <meta property="og:type" content="website">
    <meta property="og:url" content={`https://www.cristianserrano.ar${pathname}`}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content="https://www.cristianserrano.ar/og-image.png">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content="https://www.cristianserrano.ar/og-image.png">

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Resolve the stored appearance before first paint, so there is no flash.
         "system" stores nothing and sets no attribute: :root carries
         color-scheme: light dark, so the OS is followed natively and live. -->
    <script is:inline src="/js/appearance-init.js"></script>

    <!-- The upright Inter faces, asked for at once rather than after the
         styles are read, so they are usually in place for the first paint
         (see styles/tokens/type.css). -->
    {['Light', 'Regular', 'Medium', 'SemiBold', 'Bold'].map((face) => (
      <link rel="preload" href={`/fonts/inter/Inter-${face}.woff2`} as="font" type="font/woff2" crossorigin />
    ))}
    <link rel="icon" type="image/png" href="/favicon.png" sizes="16x16 32x32">
    <script type="application/json" id="guide-data" set:html={JSON.stringify(guide)} />
    <!-- Hold the first paint until the guide is rebuilt (see the end of
         <body>), so a page change never shows it half-built. -->
    <link rel="expect" href="#guide-ready" blocking="render">
    <script defer is:inline src="/js/header-behaviour.js"></script>
    <script defer is:inline src="/js/seniority.js"></script>
    {readingTime && <script defer is:inline src="/js/reading-time-estimation.js"></script>}
    <script defer is:inline src="/js/current-year.js"></script>
    <script defer is:inline src="/js/appearance.js"></script>
  </head>

  <body>
    <!-- tabindex -1: focusable by script, not in the Tab order; see
         header-behaviour.js (keyboard scrolling of the panel). -->
    <div class="page" tabindex="-1">

      <header class="site-header nav-visible">
        <nav class="site-nav" aria-label="Site">
          <a class="site-name" href="/" aria-current={pathname === '/' ? 'page' : undefined}>Cristian <span>Serrano</span></a>
          <ul>
            {nav.map((item) => (
              <li><a href={item.href} aria-current={item.current ? 'page' : undefined}>{item.label}</a></li>
            ))}
          </ul>

          <div class="site-actions">
            <button type="button" class="display-toggle" popovertarget="display" aria-label="Display: mode, temperature and accent" title="Display">
              <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6.25" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M8 1.75a6.25 6.25 0 0 1 0 12.5z" fill="currentColor"/></svg>
            </button>
            <button type="button" class="guide-toggle" data-assistant-toggle aria-controls="assistant" aria-expanded="false" aria-label="Guide" title="Guide">
              <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"><path d="M7 1.75c.4 2.9 1.85 4.35 4.75 4.75-2.9.4-4.35 1.85-4.75 4.75C6.6 8.35 5.15 6.9 2.25 6.5 5.15 6.1 6.6 4.65 7 1.75z"/><path d="M12.25 9.5c.2 1.35.9 2.05 2.25 2.25-1.35.2-2.05.9-2.25 2.25-.2-1.35-.9-2.05-2.25-2.25 1.35-.2 2.05-.9 2.25-2.25z"/></svg>
            </button>
          </div>
        </nav>

        <div class="display" id="display" popover>
          <p id="display-scheme">Mode</p>
          <div role="group" aria-labelledby="display-scheme">
            <button type="button" data-scheme="system">System</button>
            <button type="button" data-scheme="light">Light</button>
            <button type="button" data-scheme="dark">Dark</button>
          </div>
          <p id="display-temperature">Temperature</p>
          <div role="group" aria-labelledby="display-temperature">
            <button type="button" data-temperature="warm">Warm</button>
            <button type="button" data-temperature="neutral">Neutral</button>
            <button type="button" data-temperature="cold">Cold</button>
          </div>
          <p id="display-accent">Accent</p>
          <div class="accents" role="group" aria-labelledby="display-accent">
            {accents.map((name) => (
              <button
                type="button"
                class="accent-swatch"
                data-accent={name}
                accent={name}
                aria-label={name}
                title={name}
              />
            ))}
          </div>
        </div>
      </header>

      <div class="page-body">
        <main class="prose" id={readingTime ? 'content' : undefined}>
          {piece && <PieceHeader slug={piece} readingTime={readingTime} />}
          <slot />
          {piece && <NextPiece slug={piece} />}
        </main>

        <footer class="site-footer">
          <p>Handcrafted with <span class="love">♥</span> en La Plata <span class="emoji" role="img" aria-label="argentina">🇦🇷</span> und München <span class="emoji" role="img" aria-label="deutschland">🇩🇪</span>.</p>
          <p>&copy;<span class="current-year"></span> Cristian Serrano</p>
        </footer>
      </div>

    </div>

    <nav class="dock" aria-label="Quick actions">
      <button type="button" data-assistant-toggle aria-controls="assistant" aria-expanded="false">Guide</button>
      {next && <a href={href(next)} rel="next">Next piece</a>}
    </nav>

    <aside class="assistant" id="assistant" aria-label="Assistant">
      <header class="assistant-header">
        <h2>Guide</h2>
        <div class="assistant-actions">
          <button type="button" class="icon-button" data-assistant-clear aria-label="Clear chat" title="Clear chat" disabled>
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.75 4.25h10.5M6.25 4.25V2.75h3.5v1.5M4 4.25l.6 8.4c.05.7.63 1.1 1.3 1.1h4.2c.67 0 1.25-.4 1.3-1.1l.6-8.4M6.75 7v4M9.25 7v4"/></svg>
          </button>
          <button type="button" class="icon-button" data-assistant-close aria-label="Close guide" title="Close">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8"/></svg>
          </button>
        </div>
      </header>

      <div class="assistant-thread">
        <!-- The blank state: until the first question, what the guide can do
             here, with suggestions that fit the page. Filled by assistant.js. -->
        <section class="assistant-empty" aria-labelledby="guide-empty-title" hidden>
          <span class="assistant-mark" aria-hidden="true">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"><path d="M7 1.75c.4 2.9 1.85 4.35 4.75 4.75-2.9.4-4.35 1.85-4.75 4.75C6.6 8.35 5.15 6.9 2.25 6.5 5.15 6.1 6.6 4.65 7 1.75z"/><path d="M12.25 9.5c.2 1.35.9 2.05 2.25 2.25-1.35.2-2.05.9-2.25 2.25-.2-1.35-.9-2.05-2.25-2.25 1.35-.2 2.05-.9 2.25-2.25z"/></svg>
          </span>
          <h3 id="guide-empty-title" data-empty-title></h3>
          <ul class="assistant-options" data-empty-options></ul>
        </section>
        <ol class="assistant-log" aria-live="polite"></ol>
        <button type="button" class="assistant-jump" aria-label="Jump to latest" title="Jump to latest" hidden>
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3v10M4 9l4 4 4-4"/></svg>
        </button>
      </div>

      <section class="assistant-keep" aria-label="Keep this chat" hidden>
        <h3>Keep this chat for next time?</h3>
        <p>Otherwise it's gone when you leave.</p>
        <div>
          <button type="button" data-keep="no">No thanks</button>
          <button type="button" data-keep="yes">Keep it</button>
        </div>
      </section>

      <form class="assistant-composer">
        <textarea rows="2" aria-label="Message" placeholder="Ask about Cristian’s work, CV or this site…"></textarea>
        <div>
          <!-- Send; while an answer streams it becomes Stop, in the same place. -->
          <button type="submit" class="icon-button" aria-label="Send" disabled>
            <svg data-icon="send" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 13V3M4 7l4-4 4 4"/></svg>
            <svg data-icon="stop" viewBox="0 0 16 16" aria-hidden="true"><rect x="4" y="4" width="8" height="8" rx="1.5" fill="currentColor"/></svg>
          </button>
        </div>
      </form>
      <p class="assistant-disclaimer">Answers by an AI model. It can be wrong.</p>

      <!-- Feedback on an answer. A modal of THIS panel only: its backdrop
           covers the guide, never the page. See styles/components/modal.css. -->
      <div class="panel-modal" data-feedback hidden>
        <dialog open aria-modal="true" aria-labelledby="feedback-title">
          <form>
            <h3 id="feedback-title" data-feedback-title>What went wrong?</h3>
            <ul class="feedback-reasons" data-feedback-reasons aria-label="Reasons"></ul>
            <textarea rows="3" aria-label="Anything to add? (optional)" placeholder="Anything to add? (optional)"></textarea>
            <p>Prototype: feedback stays in your browser for now.</p>
            <div>
              <button type="button" data-feedback-cancel>Cancel</button>
              <button type="submit">Send</button>
            </div>
          </form>
        </dialog>
      </div>
    </aside>

    <!-- The handle between the page and the guide: drag (or arrow keys)
         to resize the guide. Wide screens with the guide open only. -->
    <div class="panel-resizer" role="separator" aria-orientation="vertical"
         aria-label="Resize the guide" aria-controls="assistant" tabindex="0"></div>

    <!-- Not deferred: it runs here, before the first paint, so the guide is
         complete when the page appears. The marker after it releases the
         render block set in <head>. -->
    <script is:inline src="/js/guide-ai.js"></script>
    <script is:inline src="/js/assistant.js"></script>
    <span id="guide-ready" hidden></span>
  </body>
</html>
