---
/* A piece's image: an optimised <Image> for files in src/assets, a plain
   <img> for a path in public/ (the JustRelate cover is one, for now). */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props { src: ImageMetadata | string; alt: string; eager?: boolean; }
const { src, alt, eager = false } = Astro.props;
const loading = eager ? 'eager' : 'lazy';
const fetchpriority = eager ? 'high' : undefined;
---
{typeof src === 'string'
  ? <img src={src} alt={alt} loading={loading} fetchpriority={fetchpriority} decoding="async">
  : <Image src={src} alt={alt} loading={loading} fetchpriority={fetchpriority} decoding="async" />}
