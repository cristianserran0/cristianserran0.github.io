  <section id="hero">
    <h1 class="hero-title">JustRelate Home</h1>
    <h2 class="hero-subtitle">JUSTRELATE · DEC 2024 – PRESENT<br><span class="blog-paragraph"><span id="reading-time"></span> min read.</span></h2>
