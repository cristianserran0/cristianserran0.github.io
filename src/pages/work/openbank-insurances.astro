---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import heroImg from '../../assets/work/openbank-insurances/hero.png';
---

<Layout
  title="Openbank Insurances - Cristian Serrano"
  description="Case study: Openbank Insurances — UX and visual design work by Cristian Serrano for Openbank's insurance product offerings, via Globant."
>
  <section id="hero">
    <h1 class="hero-title">Insurances</h1>
    <h2 class="hero-subtitle">GLOBANT + OPENBANK · 2018<br><span class="blog-paragraph"></span></h2>
    <figure class="work-hero-figure">
      <Image src={heroImg} alt="" class="work-image-large" loading="eager" fetchpriority="high" />
    </figure>
  </section>

  <section id="summary">
    <article class="overview">
      <p class="blog-lead-paragraph">I joined Globant to become part of a large-scale digital products design and development multidisciplinary team. I've found myself working with Openbank, the 100% digital bank of the Santander Group. I was part of a group formed by hybrid (UX/UI) designers with focus on creating meaningful experiences on Insurance products, both for web and mobile platforms.</p>
    </article>

    <article id="basics">
      <div class="section-table">
        <div class="section-table-cell">
          <h4 class="blog-text-3">Category</h4>
          <p class="blog-paragraph">B2C, Banking.</p>
        </div>
        <div class="section-table-cell">
          <h4 class="blog-text-3">Platforms</h4>
          <p class="blog-paragraph">Web, iOS, Android</p>
        </div>
        <div class="section-table-cell">
          <h4 class="blog-text-3">Role</h4>
          <p class="blog-paragraph">UX/UI Designer</p>
        </div>
        <div class="section-table-cell">
          <h4 class="blog-text-3">Time</h4>
          <p class="blog-paragraph">5 months</p>
        </div>
      </div>
    </article>
  </section>

  <hr class="bold-divider">

  <section id="context">
    <h2 class="blog-text-2">Case study in progress</h2>
  </section>

  <div class="end-mark-wrapper">
    <p class="end-mark">◼︎</p>
  </div>
</Layout>
