---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import coverKaia from '../../assets/work/work3-cover.png';
import coverGoogle from '../../assets/work/work1-cover.png';
import coverOpenbank from '../../assets/work/work2-cover.png';
---

<Layout
  title="Work Cristian Serrano - Digital Product Designer"
  description="Featured product design work by Cristian Serrano — design systems, UX, and product design for Kaia Health, Google, Openbank, and more."
>
  <section id="hero">
    <h1 class="hero-title">Featured work</h1>
  </section>

  <section id="work">
    <a href="/work/justrelate-head-of-design/" class="work-tile">
      <img loading="eager" fetchpriority="high" src="/work/justrelate-head-of-design/cover.png" alt="JustRelate Home">
      <div class="work-tile-caption">
        <h2 class="work-tile-title">JustRelate Home</h2>
        <p class="work-tile-detail">JustRelate</p>
      </div>
    </a>
    <a href="/work/kaia-health-kinetic-design-system/" class="work-tile">
      <Image src={coverKaia} alt="Kinetic Design System" loading="lazy" decoding="async" />
      <div class="work-tile-caption">
        <h2 class="work-tile-title">Kinetic Design System</h2>
        <p class="work-tile-detail">Kaia Health</p>
      </div>
    </a>
    <a href="/work/google-small-business-advisors/" class="work-tile">
      <Image src={coverGoogle} alt="Small Business Advisors" loading="lazy" decoding="async" />
      <div class="work-tile-caption">
        <h2 class="work-tile-title">Small Business Advisors</h2>
        <p class="work-tile-detail">Globant + Google</p>
      </div>
    </a>
    <a href="/work/openbank-design-system/" class="work-tile">
      <Image src={coverOpenbank} alt="Openbank Design System" loading="lazy" decoding="async" />
      <div class="work-tile-caption">
        <h2 class="work-tile-title">Openbank Design System</h2>
        <p class="work-tile-detail">Globant + Openbank</p>
      </div>
    </a>
  </section>
</Layout>
