---
/* Distance 1, "walking the room": every featured piece with its label.
   Tiles and labels come from src/data/pieces.ts. */
import Layout from '../../layouts/Layout.astro';
import PieceImage from '../../components/PieceImage.astro';
import { featured, href } from '../../data/pieces';
---

<Layout
  title="Work Cristian Serrano - Digital Product Designer"
  description="Featured product design work by Cristian Serrano — design systems, UX, and product design for Kaia Health, Google, Openbank, and more."
>
  <header>
    <h1>Featured work</h1>
  </header>

  <section class="projects">
    {featured.map((p, i) => (
      <article class="work-tile" data-piece={p.slug}>
        <a href={href(p)}>
          <PieceImage src={p.cover} alt="" eager={i < 2} />
          <h2>{p.title}</h2>
        </a>
        <p>{p.client} · {p.years}</p>
        <p>{p.label}</p>
      </article>
    ))}
  </section>
</Layout>
