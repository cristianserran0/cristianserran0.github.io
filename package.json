{
  "name": "cristian-portfolio",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run check:tokens && astro build && node scripts/guide-index.mjs",
    "preview": "astro preview",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "snapshot:save": "node scripts/snapshot.mjs save .snapshot.json",
    "snapshot:compare": "node scripts/snapshot.mjs compare .snapshot.json",
    "check": "npm run check:tokens && npm run check:contrast",
    "deploy": "wrangler deploy",
    "dev:worker": "npm run build && wrangler dev --env dev"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "latest"
  },
  "devDependencies": {
    "wrangler": "^4.151.1"
  }
}
